// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "sqlite"
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
}


model Video {
  id          String   @id @default(uuid())
  title       String   // Название видеолекции
  description String?  // Краткое описание или таймкоды
  url         String   // Защищенная ссылка iframe (VK Видео / Kinescope)
  isPremium   Boolean  @default(true) // true — только Мастер-Группе, false — открытое видео
  sectionNum  Int      // Номер задания ЕГЭ, к которому привязано (1-19)
  createdAt   DateTime @default(now())
}
